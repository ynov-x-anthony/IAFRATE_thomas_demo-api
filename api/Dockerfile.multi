
# syntax=docker/dockerfile:1

# Étape 1 : installation des dépendances
FROM node:24-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./

RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm ci --omit=dev

# Étape 2 : image finale minimale, sans npm
FROM node:24-alpine AS runtime

ENV NODE_ENV=production

WORKDIR /app

# Suppression de npm et des outils de développement associés
USER root
RUN rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/lib/node_modules/corepack \
           /opt/yarn-v* \
    && rm -f /usr/local/bin/npm \
             /usr/local/bin/npx \
             /usr/local/bin/corepack \
             /usr/local/bin/yarn \
             /usr/local/bin/yarnpkg

# Copie uniquement les dépendances de production
COPY --from=deps --chown=node:node /app/node_modules ./node_modules

# Copie du code de l'API
COPY --chown=node:node server.js db.js package.json ./

USER node

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
